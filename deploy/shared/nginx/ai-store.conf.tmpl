# AI-магазин (__SITE__). Файл создаёт ai-store-install; к «Платформе для заказов» не относится.
# Удаление: rm /etc/nginx/sites-enabled/ai-store.conf && systemctl reload nginx
server {
    listen 80;
    listen [::]:80;
    server_name __SITE__;
    location / { return 301 https://$server_name$request_uri; }
}
server {
    listen 80;
    listen [::]:80;
    server_name __API__;
    location / { return 301 https://$server_name$request_uri; }
}
server {
    listen 80;
    listen [::]:80;
    server_name __MEDIA__;
    location / { return 301 https://$server_name$request_uri; }
}
server {
    listen 80;
    listen [::]:80;
    server_name __S3__;
    location / { return 301 https://$server_name$request_uri; }
}
#TLS# # --- Сайт ---
