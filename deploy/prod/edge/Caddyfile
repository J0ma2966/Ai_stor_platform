# Caddy на сервере в Германии: сайт (Next.js, 2 инстанса) и Grafana.
# Персональных данных здесь нет: сайт ходит в API (UZ) прямо из браузера.
{
	email {$ACME_EMAIL}
}

(tls_acme) {
}

(tls_internal) {
	tls internal
}

www.{$SITE_DOMAIN} {
	import tls_{$TLS_MODE}
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	import tls_{$TLS_MODE}
	header -Server
	encode zstd gzip
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy web1:3000 web2:3000 {
		lb_policy least_conn
		lb_try_duration 10s
		fail_duration 10s
		health_uri /api/healthz
		health_interval 5s
	}
}

{$GRAFANA_DOMAIN} {
	import tls_{$TLS_MODE}
	header -Server
	reverse_proxy grafana:3000
}
