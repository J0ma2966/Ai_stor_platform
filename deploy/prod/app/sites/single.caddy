# Один сервер (CADDY_SITES=single): этот же Caddy отдаёт и сайт. Инстансы Next.js
# (edge/compose.single.yml) опубликованы только на приватном адресе: WEB_UPSTREAMS.
www.{$SITE_DOMAIN} {
	import tls_{$TLS_MODE}
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	import common
	encode zstd gzip
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy {$WEB_UPSTREAMS} {
		lb_policy least_conn
		lb_try_duration 10s
		fail_duration 10s
		health_uri /api/healthz
		health_interval 5s
	}
}
