# Caddy на сервере приложения (UZ). Сертификаты Let's Encrypt выпускаются и
# продлеваются автоматически (TLS_MODE=acme) или внутренним CA (TLS_MODE=internal, staging).
# Журналы доступа выключены намеренно: в URL подписанных ссылок и запросов бывают
# персональные данные; API сам пишет access-лог без query string.
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(tls_acme) {
}

(tls_internal) {
	tls internal
}

(common) {
	import tls_{$TLS_MODE}
	header -Server
}

# --- API: 3 инстанса, балансировка по наименьшему числу соединений ---
{$API_DOMAIN} {
	import common
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	# внутренние эндпоинты не должны быть видны снаружи
	@internal path /metrics /debug/*
	respond @internal 404

	reverse_proxy api1:8080 api2:8080 api3:8080 {
		lb_policy least_conn
		# если инстанс перезапускается (деплой), запрос уходит на другой
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 10s
		# liveness: при сбое Redis/БД инстансы не выкидываются все разом (деплой сам ждёт /readyz)
		health_uri /healthz
		health_interval 5s
		health_timeout 3s
		# заголовок от клиента заменяется адресом, который видит Caddy
		header_up X-Forwarded-For {remote_host}
		transport http {
			dial_timeout 3s
			response_header_timeout 80s
		}
	}
}

# --- S3 (MinIO): подписанные ссылки на приватные фото и загрузка из API ---
{$S3_DOMAIN} {
	import common
	request_body {
		max_size 25MB
	}
	# админ-API и метрики MinIO наружу не публикуются (проверка живости — можно)
	@admin {
		path /minio/*
		not path /minio/health/live
	}
	respond @admin 404
	reverse_proxy {$MINIO_UPSTREAM} {
		# подпись SigV4 включает Host, поэтому он передаётся без изменений
		header_up Host {host}
		flush_interval -1
	}
}

# --- Публичные картинки товаров (pub/), долгий кэш. Сюда можно поставить CDN ---
{$MEDIA_DOMAIN} {
	import common
	@pub {
		method GET HEAD
		path /pub/*
	}
	handle @pub {
		rewrite * /{$S3_BUCKET}{path}
		reverse_proxy {$MINIO_UPSTREAM} {
			header_down -Set-Cookie
		}
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin "*"
		header X-Content-Type-Options nosniff
	}
	handle {
		respond 404
	}
}
