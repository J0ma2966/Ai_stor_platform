# Скопируйте в .env (он в .gitignore). Никогда не коммитьте реальные секреты.
APP_ENV=dev
JWT_SECRET=change-me-to-64-random-chars-openssl-rand-hex-32-xxxxxxxxxxxxxxxx
OTP_PEPPER=change-me-random-32-chars-xxxxxxxx
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-dev
S3_BUCKET=boutique-media
# Публичные картинки товаров (префикс pub/ бакета или CDN перед ним)
PUBLIC_MEDIA_URL=http://localhost:9000/boutique-media
# Страны, на номера которых разрешено отправлять SMS-коды
OTP_ALLOWED_PREFIXES=+998
# Одновременных обработок изображений на инстанс (каждая до ~150 МБ памяти)
UPLOAD_CONCURRENCY=4
# Публичный ключ age для шифрования бэкапов (age-keygen -y key.txt)
AGE_RECIPIENT=

# ---- AI-примерка (docs/TRYON.md) ----
# off (выключена) | mock (демо, без ключа) | gemini | fashn | http (свой сервер)
# Prod сейчас запускается с off: ключи и BIOMETRIC_S3_* тогда не нужны.
TRYON_PROVIDER=mock
# Фронтенд (на этапе сборки): false скрывает примерочную. Ставить вместе с TRYON_PROVIDER=off.
NEXT_PUBLIC_TRYON_ENABLED=true
TRYON_API_KEY=
TRYON_ENDPOINT=
TRYON_MODEL=
TRYON_WORKERS=4
TRYON_WORKER_INPROCESS=true
# Хранилище биометрии (фото клиента, результаты) — обязательно в Узбекистане в prod.
# Пусто в dev = основное хранилище.
BIOMETRIC_S3_ENDPOINT=
BIOMETRIC_S3_BUCKET=boutique-biometric
BIOMETRIC_S3_ACCESS_KEY=
BIOMETRIC_S3_SECRET_KEY=
BIOMETRIC_STORAGE_COUNTRY=

# ---- SMS (вход по коду) ----
# log — код пишется в лог (только dev); eskiz — реальная отправка через notify.eskiz.uz
SMS_PROVIDER=log
ESKIZ_EMAIL=
ESKIZ_FROM=4546
ESKIZ_PASSWORD=
# Текст должен совпадать с шаблоном, одобренным в кабинете Eskiz; %s — код.
# В тестовом режиме Eskiz разрешён только текст «Bu Eskiz dan test».
SMS_OTP_TEMPLATE=Kod dlya vhoda: %s

# ---- Оплата токенов ----
# Куда провайдер вернёт клиента после оплаты (страница баланса)
PAYMENT_RETURN_URL=http://localhost:3000/account/balance
# Click (SHOP API): из кабинета merchant.click.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_ALLOWED_IPS=
CLICK_SECRET_KEY=
# Payme (Merchant API): из кабинета business.payme.uz, касса → ключ (тестовый / боевой)
PAYME_MERCHANT_ID=
PAYME_TEST=true
PAYME_ACCOUNT_KEY=payment_id
PAYME_ALLOWED_IPS=
PAYME_KEY=
# Фискализация чека (ИКПУ/МХИК и код упаковки из tasnif.soliq.uz); пусто — без detail
PAYME_IKPU=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0

# ---- Порты на этом компьютере (локальная разработка) ----
# Если Windows пишет «An attempt was made to access a socket in a way forbidden»
# или порт занят, scripts\dev.ps1 up сам подберёт свободный и запишет его сюда.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=8080
METRICS_HOST_PORT=9090
# Порт сайта (dev.ps1 web); при смене добавьте адрес в CORS_ORIGINS
WEB_PORT=3000
