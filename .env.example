# Скопируйте в .env (он в .gitignore). Никогда не коммитьте реальные секреты.
APP_ENV=dev
JWT_SECRET=change-me-to-64-random-chars-openssl-rand-hex-32-xxxxxxxxxxxxxxxx
OTP_PEPPER=change-me-random-32-chars-xxxxxxxx
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-dev
S3_BUCKET=boutique-media
# Публичные картинки товаров (префикс pub/ бакета или CDN перед ним)
PUBLIC_MEDIA_URL=http://localhost:9000/boutique-media
# Страны, на номера которых разрешено отправлять SMS-коды
OTP_ALLOWED_PREFIXES=+998
# Одновременных обработок изображений на инстанс (каждая до ~150 МБ памяти)
UPLOAD_CONCURRENCY=4
# Публичный ключ age для шифрования бэкапов (age-keygen -y key.txt)
AGE_RECIPIENT=
